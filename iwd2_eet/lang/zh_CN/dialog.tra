@13757 = ~[AVERY 1] 信异教的外地人。~
@13758 = ~[AVERY 2]~
@13759 = ~[AVERY 3] 对你这种人我真不该抱任何的期望！~
@13760 = ~[AVERY 4] 你需要我为你做什么？~
@13761 = ~[AVERY 5] 希望这能够赶紧结束。~
@13762 = ~[AVERY 6] 走开，去忙你自己的事情。~
@13763 = ~[AVERY 7] 你在这里让我感到很不舒服。~
@13764 = ~[AVERY 8]~
@13765 = ~[AVERY 9]~
@13766 = ~[UTOR 1] 呃，我才噗要帮主你，我要这边和我漂漂亮宝贝坐一起，看他们闪闪发光。~
@13767 = ~[UTOR 2] 救-救命啊！！~
@13768 = ~[UTOR 3]~
@13769 = ~[UTOR 4] 我难过，但是火花让我快乐。~
@13770 = ~[UTOR 5] 我不喜欢难过的话，我要去跟漂漂宝贝坐一起。~
@13771 = ~[UTOR 6] 我曾经有发光的宝贝堆到天上那样高！都不记得白天长啥样。~
@13772 = ~[UTOR 7] 你找我朋友，啊？~
@13773 = ~[UTOR 8]~
@13774 = ~[UTOR 9]~
@13775 = ~[HASTENBACK 1] 可以为你效劳吗？~
@13776 = ~[HASTENBACK 2] 啊啊！这真是疯了！~
@13777 = ~[HASTENBACK 3] 这真是疯了！我们不用动武吧！~
@13778 = ~[HASTENBACK 4] 恶魔！他只是个孩子啊！救命！~
@13779 = ~[HASTENBACK 5] 我没什么好说的了。~
@13780 = ~[HASTENBACK 6] 你们听说我的事了。自从我们上次谈话后，情况依然没有改变。~
@13781 = ~[HASTENBACK 7] 离开！我要单独静一静！~
@13782 = ~[HASTENBACK 8]~
@13783 = ~[HASTENBACK 9]~
@13784 = ~[PIQUE 1] 嘿，这边……嘿，这边。~
@13785 = ~[PIQUE 2] 我已经受够了！~
@13786 = ~[PIQUE 3] 我要把你剁成碎片！~
@13787 = ~[PIQUE 4] 这里阴森森的，我一点也不想扯上关系。~
@13788 = ~[PIQUE 5] 我已经告诉过你是亚多士干的。我只知道这样而已，你就放我走吧。~
@13789 = ~[PIQUE 6] 我总算活着逃出来，这边现在没我的事了。~
@13790 = ~[PIQUE 7] 祝你一切都好，我都无所谓，因为我要赶快走了！~
