@13330 = ~[GIR LOF BALDUR'S GATE 2 HOSTILE] 快走开！你这坏蛋！~
@13331 = ~[GIR LOF BALDUR'S GATE 3 HOSTILE] 快走开！你这坏蛋！~
@13332 = ~[GIRL OF BEREGOST HOSTILE] 快走开！你这坏蛋！~
