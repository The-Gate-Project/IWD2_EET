@23735 = ~苏那·瑟尼~
@23736 = ~佩思~
@23737 = ~佩思~
@23738 = ~撒纳夏~
@23739 = ~支配人类~
@23740 = ~绝望~
@23741 = ~毒咒~
@23742 = ~魂甲术~
@23743 = ~混乱术~
@23744 = ~智能衰弱~
