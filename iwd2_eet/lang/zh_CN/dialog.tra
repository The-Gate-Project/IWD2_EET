@13617 = ~[SHADOW THIEVES HOSTILE] 滚出我的视线！我不会为你做任何事！~
@13618 = ~[SILKE POST] 请你要原谅我，因为我现在很忙。~
@13619 = ~[SILVERSHIELD HOUSEHOLD GUARD HOSTILE] 这里不欢迎你！滚出去!~
@13620 = ~[SLAVE HOSTILE] 离我远一点！~
@13621 = ~[SLAVE 2 HOSTILE] 离我远一点！~
@13622 = ~[SLAVE 3 HOSTILE] 离我远一点！~
@13623 = ~[SLAVE 4 HOSTILE] 离我远一点！~
@13624 = ~[SLAVE 5 HOSTILE] 离我远一点！~
@13625 = ~[SLAVE 6 HOSTILE] 离我远一点！~
@13626 = ~[SMITH POST LOW CHAR.] 我想你学乖了吧？如果不是，大门在这里。~
@13627 = ~[SMITH POST HIGH CHAR.] 欢迎回来。希望我们帮得上忙。~
@13628 = ~[SMITH HOSTILE] 只要我还活着，我就不会相信你！~
@13629 = ~[SMUGGLERS/BALDUR'S GATE HOSTILE] 你在这里已没有朋友！快走开！~
@13630 = ~[THALDORN HOSTILE] 走开，不然你会后悔！~
@13631 = ~[THIEVESGUILD/GANTOLANDON HOSTILE] 我要教教你们尊重别人！你们得躺着离开！~
@13632 = ~[THIEVESGUILD/NARLEN HOSTILE] 叫你们小家伙注意点！离我这边远一点，不然眼睛被刀子刺瞎了别怪我！~
@13633 = ~[THIEVESGUILD/NIKLOS HOSTILE] 你在这里已没有朋友！快走开！~
@13634 = ~[THIEVESGUILD/RESAR HOSTILE] 你死了我会很高兴的！~
@13635 = ~[THIEVESGUILD/WATCHMAN HOSTILE] 坏蛋！我要把你脖子扭下来。~
@13636 = ~[TOR LOBO HOSTILE] 我要打死你！这是你应得的报应！~
@13637 = ~[TOWNSFOLK, FEMALE, BEREGOST 2 (KAITLIN) POST] 我已经跟你说过了，你不许在这里！快滚！~
@13638 = ~[TOWNSFOLK, FEMALE, BEREGOST 2 (KAITLIN) HOSTILE] 你已经不受欢迎了！~
@13639 = ~[TOWNSFOLK, FEMALE, BEREGOST 3 (MALICIA) POST] 我这次可没那么有耐心。转头离开，否则你很快会含恨而死！~
@13640 = ~[TOWNSFOLK, FEMALE, BEREGOST 3 (MALICIA) HOSTILE] 你没机会了！滚开！~
@13641 = ~[TOWNSFOLK, FEMALE, BEREGOST 4 (HENRETTE) HOSTILE] 离我远一点！~
@13642 = ~[TOWNSFOLK, FEMALE, BEREGOST 5 HOSTILE] 离我远一点！~
@13643 = ~[TOWNSFOLK, FEMALE, BEREGOST 6 POST] 如果我是你，我就不会这里乱晃。妈妈生气的时候很凶。~
@13644 = ~[TOWNSFOLK, FEMALE, BEREGOST 6 HOSTILE] 离我远一点！~
@13645 = ~[TOWNSFOLK, FEMALE, BEREGOST 7 HOSTILE] 这里不欢迎你！~
@13646 = ~[TOWNSFOLK, FEMALE, BEREGOST 8 POST]  如果你还不走，我就叫人来”帮“你。~
@13647 = ~[TOWNSFOLK, FEMALE, BEREGOST 8 HOSTILE] 这里不欢迎你！~
@13648 = ~[TOWNSFOLK, FEMALE, BEREGOST 9 (SARI) HOSTILE] 这里不欢迎你！~
@13649 = ~[TOWNSFOLK, FEMALE/BEREGOST HOSTILE] 我没啥可以帮你的。~
@13650 = ~[TOWNSFOLK, FEMALE/FRIENDLY ARM HOSTILE] 滚！~
@13651 = ~[TOWNSFOLK, MALE, BEREGOST 10 HOSTILE] 你在这里已没有朋友！快走开！~
@13652 = ~[TOWNSFOLK, MALE, BEREGOST 11 POSTHAVENOT] 嗨？喔，又是你。很抱歉，我现在没有心情说话。请走吧。~
@13653 = ~[TOWNSFOLK, MALE, BEREGOST 11 POSTGIVENOT] 又是你？！你竟敢再次踏入我的房子！我再也不想见到你！滚！~
@13654 = ~[TOWNSFOLK, MALE, BEREGOST 11 HOSTILE] 快出去，免得我把你轰出去！~
@13655 = ~[TOWNSFOLK, MALE, BEREGOST 7 (DAVIS) HOSTILE] 你没机会了！滚开！~
@13656 = ~[TOWNSFOLK, MALE, BEREGOST 2 (BERDEN) HOSTILE] 你已经不受欢迎了！~
@13657 = ~[TOWNSFOLK, MALE, BEREGOST 3 (DATH) HOSTILE] 你已经不受欢迎了！~
@13658 = ~[TOWNSFOLK, MALE, BEREGOST 4 (SOLGEN) HOSTILE] 你的行为是错的！走开！~
@13659 = ~[TOWNSFOLK, MALE, BEREGOST 5 (BORLAND) POST HIGH CHAR.] 嗨，又是你。我相信你正在享受贝尔苟斯特那枯燥贫乏的华丽？~
@13660 = ~[TOWNSFOLK, MALE, BEREGOST 5 (BORLAND) POST LOW CHAR.] 我不欢迎你。这句话我并不常说，尽管如此，这是真心话。请离开。~
@13661 = ~[TOWNSFOLK, MALE, BEREGOST 5 (BORLAND) HOSTILE] 我不是有意无礼，不过请你马上离开。~
@13662 = ~[TOWNSFOLK, MALE, BEREGOST 8 POST] 别烦我，我正忙着打包。~
@13663 = ~[TOWNSFOLK, MALE, BEREGOST 8 HOSTILE] 你没机会了！滚开！~
@13664 = ~[TOWNSFOLK, MALE, BEREGOST 9 HOSTILE] 滚出我的视线！我不会为你做任何事！~
@13665 = ~[TOWNSFOLK, MALE, BEREGOST 6 HOSTILE] 滚出我的视线！我不会为你做任何事！~
@13666 = ~[TOWNSFOLK, MALE/BALDUR'S GATE HOSTILE] 你敢再靠近一步我就甩你耳光！~
@13667 = ~[TOWNSFOLK, MALE/BEREGOST HOSTILE] 你敢再靠近一步我就甩你耳光！~
@13668 = ~[TOWNSFOLK, MALE/FRIENDLY ARM HOSTILE] 你敢再靠近一步我就甩你耳光！~
@13669 = ~[TOWNSFOLK/TOWNCRIER/BEREGOST HOSTILE] 离我远一点！我有工作要做！~
@13670 = ~[TRANZIG HOSTILE] 滚出我的视线！我不会为你做任何事！~
@13671 = ~[TRAVELER - FRIENDLY ARM INN (WADE) POST HIGH CHAR.] 然后我对那个人说：“可是，如果那个是你妹妹的话，那我老婆在哪里？”哈！哦，对不起，我的口水是不是喷到你了？噢，我的朋友回来了！我只是想喝点酒好壮壮胆继续旅行。也许我该多待一会儿，外面的天气虽然不错，可是我的脑袋却是乌云密布。~
@13672 = ~[TRAVELER - FRIENDLY ARM INN (WADE) POST LOW CHAR.] 嘿，脑袋被人出乎意外地踢了一脚的滋味如何；我们的苦瓜脸先生回到开心果的地盘了。我相信你变得友善点了吧？~
@13673 = ~[TRAVELER - FRIENDLY ARM INN (WADE) HOSTILE] 我不是有意无礼，不过请你马上离开。~
@13674 = ~[TRAVELER 2 HOSTILE] 我不是有意无礼，不过请你马上离开。~
@13675 = ~[VICONIA POST] 滚开！地表人渣！~
@13676 = ~[VOLO'S SERVING WENCH HOSTILE] 你没机会了！滚开！~
@13677 = ~[WAITER HOSTILE] 滚出我的视线！我不会为你做任何事！~
@13678 = ~[WATCHER 2 HOSTILE] 你做出那种事，以后我绝对不会再让你们靠近我了！~
@13679 = ~[WILTON POST] 抱歉啦，年轻人，但是我还有很多耕田的事情要做。~
@13680 = ~[WILTON HOSTILE] 离我远一点，我跟你没什么好说的。~
@13681 = ~[XAN POST] 如果我的举动显得卤莽，让我先向你道歉，因为我一定得走了，而且越快越好。~
@13682 = ~[YAGO POST] 你烦我烦得还不够吗！~
@13683 = ~[YAGO HOSTILE] 滚出我的视线！我不会为你做任何事！~
@13684 = ~[YESLICK POST] 居然会再遇到你们！呃，我该走了，我还有人要揍呢。~
